// ─────────────────────────────────────────────────────────────
// EchoNet — Prisma Schema
// PostgreSQL database for insights, payments, and signal history
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Core Intelligence ────────────────────────────────────────

/// A causal intelligence report generated by the AI analyst.
model Insight {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  // AI output fields
  headline       String
  causalChain    String   @map("causal_chain") @db.Text
  confidence     Int      // 0-100
  riskLevel      String   @map("risk_level") // LOW | MEDIUM | HIGH
  tags           String[] // e.g. ["whale-move", "defi", "regulatory"]
  corroboratedBy String[] @map("corroborated_by") // ["Layer 1", "Layer 2"]

  // Layer summaries
  summaryOnChain String? @map("summary_on_chain")
  summaryMarket  String? @map("summary_market")
  summaryNews    String? @map("summary_news")

  // AI provider used
  aiProvider String? @map("ai_provider") // "openai", "anthropic", "groq"
  aiModel    String? @map("ai_model") // "gpt-4o", "claude-3-5-haiku", etc.

  // On-chain oracle proof
  memoSignature String? @unique @map("memo_signature")
  memoSolscan   String? @map("memo_solscan")

  // Relations
  payment   Payment? @relation()
  bundle    SignalBundle? @relation()

  @@map("insights")
}

// ── Payments (x402 Verification) ─────────────────────────────

/// An on-chain payment that unlocked an insight.
model Payment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Solana transaction
  signature   String @unique // tx signature — prevents double-spend
  payerWallet String @map("payer_wallet")
  amount      BigInt // lamports
  cluster     String @default("devnet") // "devnet" | "mainnet"
  solscanUrl  String @map("solscan_url")

  // Verification
  verified   Boolean @default(false)
  verifiedAt DateTime? @map("verified_at")

  // Link to the insight it unlocked
  insightId String  @unique @map("insight_id")
  insight   Insight @relation(fields: [insightId], references: [id])

  @@map("payments")
}

// ── Signal Bundles (Raw Data Snapshots) ──────────────────────

/// A snapshot of all sensor data at the time an insight was generated.
model SignalBundle {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Raw JSON from each layer (stored as JSONB for queryability)
  onChainData Json @map("on_chain_data") // Layer 1: Helius whale transfers
  marketData  Json @map("market_data")   // Layer 2: CoinGecko, Binance, DEX
  newsData    Json @map("news_data")     // Layer 3: CryptoPanic, NewsAPI, RSS

  // Metadata
  sourcesUsed  String[] @map("sources_used") // ["helius", "coingecko", "newsapi"]
  hasLiveData  Boolean  @default(false) @map("has_live_data")

  // Link to the insight generated from this bundle
  insightId String  @unique @map("insight_id")
  insight   Insight @relation(fields: [insightId], references: [id])

  @@map("signal_bundles")
}

// ── Provider Settings (User Preferences) ─────────────────────

/// Stores user AI provider preferences (optional — for multi-user support).
model UserSettings {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  walletAddress String @unique @map("wallet_address")

  // AI config
  aiProvider String @default("openai") @map("ai_provider")
  aiBaseUrl  String @default("https://api.openai.com/v1") @map("ai_base_url")
  aiModel    String @default("gpt-4o-mini") @map("ai_model")

  @@map("user_settings")
}
